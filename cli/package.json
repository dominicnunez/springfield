{
  "name": "sfk",
  "version": "1.0.0",
  "description": "Springfield Kit — Autonomous AI coding agent with enforced test verification",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sfk": "./bin.js"
  },
  "files": [
    "dist",
    "bin.js",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --minify --target=bun-darwin-arm64 --outfile dist/sfk-darwin-arm64",
    "build:darwin-arm64": "bun build src/index.ts --compile --minify --target=bun-darwin-arm64 --outfile dist/sfk-darwin-arm64",
    "build:darwin-x64": "bun build src/index.ts --compile --minify --target=bun-darwin-x64 --outfile dist/sfk-darwin-x64",
    "build:linux-x64": "bun build src/index.ts --compile --minify --target=bun-linux-x64 --outfile dist/sfk-linux-x64",
    "build:linux-arm64": "bun build src/index.ts --compile --minify --target=bun-linux-arm64 --outfile dist/sfk-linux-arm64",
    "build:windows-x64": "bun build src/index.ts --compile --minify --target=bun-windows-x64 --outfile dist/sfk-windows-x64.exe",
    "build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:windows-x64",
    "lint": "biome check src/",
    "lint:fix": "biome check --write --unsafe src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build:all"
  },
  "keywords": [
    "ai",
    "coding",
    "automation",
    "claude",
    "opencode",
    "testing",
    "tdd",
    "cli",
    "agent",
    "llm"
  ],
  "author": "Dominic Nunez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dominicnunez/springfield.git"
  },
  "homepage": "https://github.com/dominicnunez/springfield#readme",
  "bugs": {
    "url": "https://github.com/dominicnunez/springfield/issues"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@types/bun": "^1.1.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
